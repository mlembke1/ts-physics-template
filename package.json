{
  "name": "ts-physics-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecov": "type-coverage --strict --at-least 100",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src",
    "require:check": "node scripts/check-required-gates.mjs",
    "deadcode": "knip",
    "spell": "cspell --no-progress --gitignore \"**/*.{ts,tsx,js,mjs,cjs,md}\"",
    "license:check": "node scripts/check-licenses.mjs",
    "test": "vitest run --coverage",
    "mutation": "stryker run",
    "audit": "pnpm audit --audit-level=moderate",
    "sbom": "FETCH_LICENSE=false pnpm dlx @cyclonedx/cdxgen@latest -t js . -o sbom.cdx.json",
    "bootstrap": "node scripts/bootstrap.mjs",
    "postinstall": "node scripts/bootstrap.mjs --auto",
    "prepare": "lefthook install",
    "floor": "node scripts/check-floor.mjs",
    "gates": "node --test scripts/self-test.mjs",
    "verify": "pnpm typecheck && pnpm typecov && pnpm lint && pnpm format:check && pnpm arch && pnpm require:check && pnpm floor && pnpm gates && pnpm deadcode && pnpm spell && pnpm license:check && pnpm run audit && pnpm test && pnpm mutation"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "qs@<6.16.0": ">=6.16.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "cspell": "10.3.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
